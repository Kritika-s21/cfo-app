# Copy to .env (never commit .env)
EZCOWORKER_BASE_URL=https://ezcoworker.ezdatamunch.com/api
EZCOWORKER_API_KEY=
EZCOWORKER_CHAT_TIMEOUT=300

# Optional server-to-server API keys (comma-separated); browser users sign in with accounts.
CFO_API_KEYS=

# Browser origins allowed to use cookie-based authentication.
CFO_CORS_ORIGINS=https://ezaicfoagent.ezdatamunch.com
# Use 1 when TLS terminates at a proxy or the API is served over HTTPS.
AUTH_COOKIE_SECURE=1
# Use the same SQL Server database as file-scheduler, but isolated auth tables.
# Can be a SQLAlchemy URL or an ODBC-style string (Server=...;Database=...;UID=...;PWD=...).
# Falls back to SQL_CONNECTION_STRING when set; never expose this as a VITE_ variable.
# CFO_AUTH_SQL_CONNECTION_STRING=
# SQL_ODBC_DRIVER=ODBC Driver 17 for SQL Server
# Local-development fallback only when no SQL Server connection is configured:
# CFO_AUTH_DATABASE_PATH=auth.sqlite3

# Optional paths
POLICY_DIR=policies
RUNS_FILE=runs.jsonl

# Knowledge layer
VECTOR_BACKEND=lancedb          # lancedb | memory
LANCEDB_URI=lancedb
EMBEDDINGS=hash                 # hash (dev only) | openai | sentence-transformers
# OPENAI_API_KEY=               # only if EMBEDDINGS=openai
SKILLS_DIR=skills
GRAPH_FILE=policy_graph.json

# Scheduler (schedules start disabled; enable them via the API)
SCHEDULER_ENABLED=1
SCHEDULES_FILE=schedules.json
SCHED_WORKERS=2
EVENTS_FILE=events.jsonl

# Optional: pin every run to ONE existing EzCoworker conversation (integer id). Leave empty: each run starts a new one.
# EZCOWORKER_CONVERSATION_ID=

# Logging (console + logs/app.log + logs/error.log)
LOG_DIR=logs
LOG_LEVEL=INFO
# Used by `python main.py`
PORT=8766

# Registry behind GET /api/v1/files (the chat "Scanned files" picker)
FILES_REGISTRY=files_registry.json
