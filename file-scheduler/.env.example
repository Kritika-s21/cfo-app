# Copy to file-scheduler/.env  (separate from backend/.env)
API_PORT=8765
SCHED_MASTER_KEY=                  # Fernet key used to encrypt source credentials
SQL_CONNECTION_STRING=
VECTOR_DB_PATH=./lance_db
EMBEDDING_PROVIDER=ollama
LOG_DIR=./agent_logs

# ── Bridge to the CFO Back Office agents (cfo_bridge.py) ──
CFO_BRIDGE_ENABLED=1
CFO_API_BASE=http://localhost:8766
CFO_API_KEY=                       # one of backend/.env CFO_API_KEYS (leave empty if auth is off)
CFO_RULES_FILE=cfo_rules.json      # copy cfo_rules.example.json -> cfo_rules.json and edit
CFO_UPLOAD_ALWAYS=1
