# Copy to .env  (Vite only exposes variables prefixed with VITE_)
# File Pickup Scheduler backend (api_server.py)
VITE_API_BASE=http://localhost:8766
# CFO orchestration backend (backend/main.py)
VITE_CFO_API_BASE=http://localhost:8765
# Must match one of the backend's CFO_API_KEYS (visible in the browser, internal use only)
VITE_CFO_API_KEY=
# Dev only: when the backend call fails, show clearly labelled SAMPLE figures instead of an error. Leave unset in real use.
# VITE_ALLOW_DEMO_DATA=1
