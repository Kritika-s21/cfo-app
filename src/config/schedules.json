[
  {
    "id":                    "local_uploads",
    "label":                 "Local Upload Folder",
    "type":                  "local",
    "on":                    true,
    "path":                  "watched_files",
    "recursive":             true,
    "file_pattern":          "*.xlsx,*.csv,*.pdf",
    "poll_interval_seconds": 30,
    "notes":                 "Drop files into ./watched_files/ — picked up every 30 seconds"
  },
  {
    "id":                    "s3_finance_bucket",
    "label":                 "AWS S3 — Finance Uploads",
    "type":                  "s3",
    "on":                    false,
    "bucket":                "my-cfo-finance-uploads",
    "prefix":                "incoming/",
    "file_pattern":          "*.xlsx",
    "poll_interval_seconds": 120,
    "notes":                 "Set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION in .env"
  },
  {
    "id":                    "azure_finance_blob",
    "label":                 "Azure Blob — Finance Container",
    "type":                  "azure",
    "on":                    false,
    "container":             "cfo-uploads",
    "prefix":                "raw/",
    "file_pattern":          "*.csv",
    "poll_interval_seconds": 180,
    "notes":                 "Set AZURE_STORAGE_CONNECTION_STRING in .env"
  },
  {
    "id":                    "gcs_finance_bucket",
    "label":                 "GCP Cloud Storage — Finance Bucket",
    "type":                  "gcs",
    "on":                    false,
    "bucket":                "my-cfo-gcs-bucket",
    "prefix":                "uploads/",
    "file_pattern":          "*.xlsx",
    "poll_interval_seconds": 120,
    "notes":                 "Set GOOGLE_APPLICATION_CREDENTIALS in .env"
  }
]
